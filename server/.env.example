MONGO_URI=your_mongodb_connection_string
PORT=5050
CLIENT_ORIGIN=http://localhost:3000
# CLIENT_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Optional development/test seeding only. Uncomment in your ignored .env.
# Use a dedicated test instance or credentials restricted to the selected test DB.
# NODE_ENV=development
# SEED_MONGO_URI=mongodb://127.0.0.1:27017
# SEED_DB_NAME=codebloggs_test_local
# Set your own test-only password: at least 12 characters, at most 72 UTF-8 bytes.
# SEED_TEST_PASSWORD=
